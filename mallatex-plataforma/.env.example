# =====================================================================
#  Plataforma Mallatex — variables de entorno (copiar a .env)
# =====================================================================

# --- Entorno ---
NODE_ENV=development

# --- Base de datos (PostgreSQL) ---
# Todos los microservicios comparten la misma base con esquemas por contexto.
DATABASE_URL=postgres://mallatex:mallatex@localhost:5432/mallatex
DATABASE_SSL=false
# Alternativa local sin Postgres (sólo dev): DB_DIALECT=sqlite
# DB_DIALECT=sqlite
# SQLITE_STORAGE=./data/mallatex.sqlite
DB_LOGGING=false

# --- Autenticación ---
JWT_SECRET=cambia-esto-en-produccion
AUTH_TTL_HOURS=12
JWT_ISSUER=mallatex-plataforma
# Rate limit de login (intentos FALLIDOS por ip+cuenta)
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MIN=15
# Propagación de sesiones revocadas entre servicios (ms)
REVOCATION_REFRESH_MS=30000

# --- HTTP ---
# En producción fija CORS_ORIGINS a la lista EXACTA de orígenes (nunca '*'):
# con '*' se refleja cualquier origen y se deshabilitan las credenciales.
CORS_ORIGINS=*
JSON_LIMIT=10mb
# Detrás del gateway/balanceador, TRUST_PROXY=true para ver la IP real
# (rate limiting por IP de endpoints públicos).
TRUST_PROXY=false

# --- Gateway: URLs internas de los microservicios ---
IDENTITY_URL=http://localhost:3001
ATTENDANCE_URL=http://localhost:3002
CRM_URL=http://localhost:3003
MES_URL=http://localhost:3004
LEADS_URL=http://localhost:3005
MARKETING_URL=http://localhost:3006

# --- Puertos (por proceso) ---
# PORT lo fija cada servicio (identity 3001 ... gateway 3000)

# --- Empresa ---
COMPANY_NAME=Tejidos Técnicos Mallatex S.A. de C.V.

# --- Integraciones (mock|http) ---
G3_MODE=mock
G3_BASE_URL=
G3_TOKEN=
MES_MODE=mock
ASPEL_MODE=mock
ASPEL_CFDI_URL=
ASPEL_WEBHOOK_SECRET=cambia-esto

# --- Marketing: almacenamiento S3/R2 para VIDEO (opcional) ---
# Con S3_MODE=off los videos se guardan en la base marcados "pendiente de
# sincronizar"; al configurar el bucket, el boton "Sincronizar a S3" (o
# POST /api/mkt/assets/sync-s3) los migra sin perder nada.
S3_MODE=off
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Para Cloudflare R2 u otro S3-compatible: endpoint completo
S3_ENDPOINT=
# Limite de video aceptado en base mientras no hay bucket (MB)
MKT_VIDEO_DB_MAX_MB=25

# --- Correo (leads / sorteo, opcional) ---
MANDRILL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@mallatex.mx

# --- Frontend web (Next.js) ---
NEXT_PUBLIC_API_BASE=http://localhost:3000
