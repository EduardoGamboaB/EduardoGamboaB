# Configuración de Mallatex · Plataforma de Asistencia (NOI)
# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.

# --- Entorno ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Persistencia ---
# STORAGE=postgres (recomendado en producción) o file (archivo JSON, una sola instancia).
STORAGE=postgres
DATABASE_URL=postgres://mallatex:cambia-esta-contrasena@db:5432/mallatex
# Contraseña de PostgreSQL para docker-compose:
POSTGRES_PASSWORD=cambia-esta-contrasena
# PGSSL=true  # si tu Postgres exige TLS (p. ej. servicios gestionados)

# Sólo para STORAGE=file (montar como volumen):
DATA_DIR=/data
BACKUP_ON_START=true
BACKUP_KEEP=14

# --- Red / proxy / TLS ---
# Detrás de un reverse-proxy (nginx/traefik/ELB) que termina TLS:
TRUST_PROXY=1
ENABLE_HSTS=true
# Orígenes CORS permitidos (separados por coma). Vacío = sólo mismo origen.
CORS_ORIGINS=

# --- Seguridad ---
ENABLE_CSP=true
SESSION_TTL_HOURS=12
LOGIN_RATE_MAX=15
LOGIN_RATE_WINDOW_MIN=15
JSON_LIMIT=2mb

# --- Arranque / datos ---
# En producción SEED_DEMO debe ser false (no cargar datos demostrativos).
SEED_DEMO=false
# Primer administrador (se crea sólo si la base está vacía y no hay datos demo).
BOOTSTRAP_ADMIN_EMAIL=admin@mallatex.mx
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-contrasena-larga
BOOTSTRAP_ADMIN_NAME=Administrador

# --- Empresa ---
COMPANY_NAME=Mallatex
NOI_COMPANY=MALLATEX
COMPANY_BRANCH=Guadalajara, Jalisco

# --- Operación ---
LOG_REQUESTS=true
