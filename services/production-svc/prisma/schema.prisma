// production-svc — órdenes de producción, líneas, mermas, productividad, peso final
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["production"]
}

enum LineaId {
  LC1
  LC2
  LC3
  LC4
  LK
  LP
  LE

  @@schema("production")
}

enum EstadoOP {
  pendiente
  en_proceso
  pausada
  terminada
  cancelada

  @@schema("production")
}

enum TipoOperacion {
  corte
  perforacion
  costura
  embobinado

  @@schema("production")
}

enum CategoriaMerma {
  sobrante
  defecto
  desperdicio

  @@schema("production")
}

enum Turno {
  MATUTINO
  VESPERTINO
  NOCTURNO

  @@schema("production")
}

model OrdenProduccion {
  id              String        @id                  // OP-2026-00131
  pedidoFolio     String                             // FK lógico
  productoMat     String                             // texto descriptivo
  linea           LineaId
  operadorIds     Int[]                              // FK lógico a identity
  meta            Int
  hechas          Int           @default(0)
  procesoActual   TipoOperacion
  estado          EstadoOP      @default(pendiente)
  fechaPlan       DateTime
  fechaInicio     DateTime?
  fechaFin        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  registros       RegistroProduccion[]
  mermas          Merma[]

  @@index([linea])
  @@index([pedidoFolio])
  @@index([estado])
  @@schema("production")
}

/// Cada tap "+1 pieza" del operador en la tablet de línea
model RegistroProduccion {
  id          String          @id @default(cuid())
  opId        String
  op          OrdenProduccion @relation(fields: [opId], references: [id])
  operadorId  Int
  turno       Turno
  piezas      Int             @default(1)
  metrosLin   Float?
  rolloUsado  String?                                // R-04563
  ts          DateTime        @default(now())

  @@index([opId])
  @@index([operadorId, ts])
  @@schema("production")
}

/// Registro de mermas — formato MT-DT-003
model Merma {
  id           String         @id @default(cuid())
  fecha        DateTime
  opId         String?
  op           OrdenProduccion? @relation(fields: [opId], references: [id])
  pedidoFolio  String
  operadorId   Int?
  operadorName String
  linea        LineaId
  material     String
  metros       Float
  categoria    CategoriaMerma
  defecto      String?
  evidenciaUrl String?
  createdAt    DateTime       @default(now())

  @@index([pedidoFolio])
  @@index([categoria])
  @@index([fecha])
  @@schema("production")
}

/// Avisos del piso — formato libre del operador
model Aviso {
  id        String   @id @default(cuid())
  hora      String                                   // "09:14"
  linea     LineaId
  operador  String
  tipo      String                                   // 'falla','sin-material',...
  desc      String
  tiempo    String                                   // duración mm:ss
  estado    String   @default("urgente")             // 'urgente','revisar','resuelto'
  createdAt DateTime @default(now())

  @@index([estado])
  @@schema("production")
}

/// Productividad por turno — reemplaza el Excel "Hora Real de Comienzo"
model ProductividadTurno {
  id             String   @id @default(cuid())
  fecha          DateTime
  linea          LineaId
  operadorName   String
  horaInicio     String
  horaFinal      String
  imprevistos    Int      @default(0)                // minutos
  tiempoEfectivo Int                                 // minutos
  mLTurno        Float    @default(0)
  piezasTurno    Int      @default(0)
  descripcion    String?
  createdAt      DateTime @default(now())

  @@index([fecha, linea])
  @@schema("production")
}

/// Producto terminado · verificación de pesaje — formato MT-DT-006
model ProductoTerminado {
  id            String   @id                         // PT-VFGC886-01
  pedidoFolio   String
  material      String
  medida        String
  rollos        Int
  pesoTeorico   Float
  pesoReal      Float
  fecha         DateTime
  hora          String
  verificado    Boolean  @default(false)
  responsable   String
  createdAt     DateTime @default(now())

  @@index([pedidoFolio])
  @@schema("production")
}

/// Configuración de línea (catálogo)
model Linea {
  id              LineaId  @id
  nombre          String
  procesoDefault  TipoOperacion
  capacidadMlHr   Float    @default(0)
  activa          Boolean  @default(true)

  @@schema("production")
}
