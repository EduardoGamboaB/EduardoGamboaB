// identity-svc — usuarios, roles, competencias, JWT
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity"]
}

enum Rol {
  operaciones
  almacen
  produccion
  montacargas
  operador
  cobranza
  compras
  admin

  @@schema("identity")
}

enum TipoOperador {
  A
  B
  C
  D

  @@schema("identity")
}

enum TipoMaquina {
  corte
  perforacion
  costura
  embobinado

  @@schema("identity")
}

model Usuario {
  id           Int          @id @default(autoincrement())
  email        String?      @unique
  name         String
  passwordHash String?
  role         Rol          @default(operador)
  tipo         TipoOperador?
  maquinas     TipoMaquina[]                          // competencias del operador
  linea        String?                                 // línea actualmente asignada
  promedioMLhr Int?
  color        String       @default("#888888")
  initial      String       @default("?")
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  refreshTokens RefreshToken[]
  auditLog      AuditLog[]

  @@schema("identity")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    Int
  user      Usuario  @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("identity")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    Int?
  user      Usuario? @relation(fields: [userId], references: [id])
  action    String                                    // 'login','logout','role.change',...
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@schema("identity")
}
