// inventory-svc — rollos, recepciones, egresos, lotes MP, ubicaciones
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["inventory"]
}

enum EstadoRollo {
  almacen
  reservado
  en_linea
  faltante

  @@schema("inventory")
}

/// Lote de MP — etiqueta original del proveedor (ej. 6619)
model Lote {
  id            String   @id
  proveedor     String
  fechaIngreso  DateTime @default(now())
  cantidadInicial Float
  cantidadDisponible Float
  notas         String?

  rollos        Rollo[]

  @@schema("inventory")
}

/// Rollo individual — etiquetado con QR (ID Mallatex)
model Rollo {
  id          String      @id                       // R-04563
  material    String
  medida      String                                 // "1.80 × 500"
  loteId      String
  lote        Lote        @relation(fields: [loteId], references: [id])
  peso        Float                                  // kg
  ubicacion   String                                 // A-3-12
  pedidoFolio String?                                // FK lógico a orders-svc
  estado      EstadoRollo @default(almacen)
  empezado    Boolean     @default(false)           // política MT-PC-002: priorizar empezados
  metadata    Json?                                  // espec extra del material
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  movimientos MovimientoRollo[]

  @@index([estado])
  @@index([pedidoFolio])
  @@index([ubicacion])
  @@schema("inventory")
}

model MovimientoRollo {
  id        String   @id @default(cuid())
  rolloId   String
  rollo     Rollo    @relation(fields: [rolloId], references: [id])
  fromUb    String?
  toUb      String?
  fromEst   String?
  toEst     String?
  motivo    String                                  // 'egreso','retorno','traspaso','ajuste'
  byUserId  String
  createdAt DateTime @default(now())

  @@index([rolloId])
  @@schema("inventory")
}

/// Recepción de proveedor — formato MT-DT-001
model Recepcion {
  id           String   @id                          // REC-2026-0142
  fecha        DateTime
  proveedor    String
  packingList  String
  factura      String
  rollos       Int
  pesoTotal    Float
  muestreoOK   Boolean                               // MT-PC-001 act. 13-19
  ingresadoSAE Boolean  @default(false)              // máx 1 día hábil
  responsable  String
  incidencia   String?
  createdAt    DateTime @default(now())

  rollosCreados RolloRecepcion[]

  @@index([fecha])
  @@index([proveedor])
  @@schema("inventory")
}

model RolloRecepcion {
  id          String    @id @default(cuid())
  recepcionId String
  recepcion   Recepcion @relation(fields: [recepcionId], references: [id])
  rolloId     String                                 // FK lógico al Rollo creado

  @@schema("inventory")
}

/// Egreso a producción — formato MT-DT-002
model Egreso {
  id                 String   @id                    // EGR-2026-0298
  fecha              DateTime
  pedidoFolio        String                          // FK lógico a orders-svc
  material           String
  rollos             Int
  m2                 Float
  empezadosUsados    Int                             // política: priorizar empezados
  responsableAlmacen String
  responsableProd    String
  confirmado         Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@index([fecha])
  @@index([pedidoFolio])
  @@schema("inventory")
}
