// Mallatex Production Suite — Modelo de datos (versión 2)
// Refleja la operación real de TEJIDOS TÉCNICOS MALLATEX, S.A. DE C.V.
// (Zapopan, Jalisco) tras revisión de documentos formales en planta:
//   MT-DT-003 · Control MP en Producción
//   MT-DT-004 · Control conteo de rollo (+ control por máquina-turno)
//   MT-DT-005 · Control de Peso Diario
//   MT-DT-006 · Devolución de Materia Prima a Almacén
//   Pedido de Almacén
//   Check List diario de Montacargas
//   Control de Insumos en el Área de Producción

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Identidad y accesos
// =====================
enum Rol {
  ADMIN
  GERENCIA
  SUPERVISOR
  JEFE_PRODUCCION
  COMERCIAL
  OPERARIO
  CALIDAD
  ALMACENISTA
  MONTACARGUISTA
}

model Usuario {
  id            String   @id @default(cuid())
  email         String   @unique
  nombre        String
  passwordHash  String
  rol           Rol      @default(OPERARIO)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pedidosVendedor    Pedido[]              @relation("PedidoVendedor")
  pedidosComerciales Pedido[]              @relation("PedidoComercial")
  ordenesCreadas     OrdenProduccion[]     @relation("OrdenCreador")
  pasosOperario      PasoProduccion[]      @relation("PasoOperario")
  registros          RegistroProduccion[]
  tiradasResponsable Tirada[]              @relation("TiradaResponsable")
  inspeccionesQC     InspeccionCalidad[]
  controlesMP        ControlMP[]
  pedidosAlmacenSol  PedidoAlmacen[]       @relation("PASolicito")
  pedidosAlmacenEnt  PedidoAlmacen[]       @relation("PAEntrego")
  rollosElaborados   Rollo[]               @relation("RolloElaborador")
  checklistsMonta    InspeccionMontacargas[] @relation("ChecklistOperador")
  checklistsMontaSup InspeccionMontacargas[] @relation("ChecklistSupervisor")
  consumosInsumos    ConsumoInsumoAux[]
}

// =====================
// Catálogo · Familias y productos
// =====================
enum FamiliaProducto {
  CUBRESUELO_NEGRO
  CUBRESUELO_AZORRILLADO
  CUBRESUELO_LINEA_VERDE
  ANTIAFIDO
  ANTIGRANIZO
  MANTA_TERMICA
  MONOFILAMENTO
  PANTALLA_TERMICA
  RASCHEL
  ESPALDERA
  EXTRUIDA
  MALLA_GALLINERA
  MALLA_TUTOR
  SOGA
  OTRO
}

enum UnidadMedida {
  METRO_LINEAL
  METRO_CUADRADO
  KILOGRAMO
  ROLLO
  PIEZA
}

/// Catálogo de producto Mallatex. SKU sigue formato real:
///   <FAMILIA><DENSIDAD/MEDIDA><COLOR><GRAMAJE?>
///   Ej.: CUNEGRO105GR, ANTIAFIDO12X22CRISTAL, RASCHEL35BLANCA
model Producto {
  id                String          @id @default(cuid())
  sku               String          @unique
  nombre            String                                    // "Cubresuelo Azorrillado 105GR"
  familia           FamiliaProducto
  descripcion       String?
  unidad            UnidadMedida    @default(METRO_LINEAL)

  // Atributos técnicos extraídos del catálogo real de fichas en almacén
  anchoMetros       Float?                                    // 1.80, 3.30, 4.10, 7.70, etc.
  largoEstandar     Float?                                    // 100, 500, 587 — largo típico del rollo
  gramaje           Int?                                      // gramos por m² (105, 80, etc.)
  porcentajeCobertura Int?                                    // 35, 40 — % sombra/transmisión
  densidadHilos     String?                                   // "10x16", "12x22", "13x31"
  color             String?                                   // negro, blanco, cristal, verde, bicolor
  colorSecundario   String?                                   // para BICOLOR o LÍNEA VERDE
  caracteristicas   String?                                   // "Perforados cada 70cm", "Plastificada 1 cara", "Confeccionada"

  // Espec. extra como JSON serializado para casos especiales
  especificaciones  String          @default("{}")
  precioBase        Float           @default(0)
  activo            Boolean         @default(true)
  creadoEn          DateTime        @default(now())

  itemsPedido       ItemPedido[]
  ordenes           OrdenProduccion[]
  movimientosStock  MovimientoStock[]
  rollos            Rollo[]
  controlesMP       ControlMP[]
}

// =====================
// Clientes
// =====================
model Cliente {
  id           String   @id @default(cuid())
  rfc          String?  @unique
  razonSocial  String
  /// Prefijo de folio del cliente, 3-5 caracteres alfanuméricos. Ej.: "VFGC", "VEG", "EZE", "P.FEL"
  /// Si es null, el pedido usa folio interno numérico de 6 dígitos.
  prefijoFolio String?
  contacto     String?
  email        String?
  telefono     String?
  direccion    String?
  ciudad       String?
  estado       String?
  notas        String?
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  pedidos      Pedido[]
}

// =====================
// Materia prima y lotes
// =====================
model MateriaPrima {
  id           String   @id @default(cuid())
  codigo       String   @unique
  nombre       String   // HDPE virgen, polipropileno, MB negro, etc.
  unidad       UnidadMedida @default(KILOGRAMO)
  stockMinimo  Float    @default(0)
  proveedor    String?
  creadoEn     DateTime @default(now())

  lotes        LoteMP[]
  movimientos  MovimientoStock[]
}

/// Lote de materia prima — número con el que se etiqueta en almacén (ej. 6619, 4153)
/// Habilita trazabilidad MP → rollo terminado.
model LoteMP {
  id               String       @id @default(cuid())
  codigo           String       @unique
  materiaPrimaId   String
  materiaPrima     MateriaPrima @relation(fields: [materiaPrimaId], references: [id])
  fechaIngreso     DateTime     @default(now())
  cantidadOriginal Float
  cantidadDisponible Float
  proveedor        String?
  notas            String?

  controlesMP      ControlMP[]
}

// =====================
// Líneas y operaciones (en lugar de máquinas individuales)
// =====================
enum TipoOperacion {
  EXTRUSION
  TEJIDO
  EMBOBINAR
  PLANCHAR
  CONFECCION
  CONFECCIONADA
  AZORRILLADO
  PERFORAR
  CORTE
  BASTILLAR
  BAJADA_COLILLOS
  BAJADA_ROLLOS
  ETIQUETADO
  EMPAQUE
  ACABADO
  OTRO
}

model Operacion {
  id          String        @id @default(cuid())
  codigo      String        @unique     // OP-EMBOB, OP-PLAN, OP-CONF, OP-COR, OP-BAS, OP-PERF, OP-BAJC, OP-BAJR
  nombre      String                    // "Embobinar", "Planchar", "Confección"...
  tipo        TipoOperacion
  descripcion String?
  activa      Boolean       @default(true)

  pasos       PasoProduccion[]
}

/// Línea de producción física. Las del tablero Mallatex:
///   LC1, LC2, LC3 → Líneas de Costura 1, 2, 3
///   LK            → Línea de Corte
///   LP            → Línea de Perforadora
model LineaProduccion {
  id                    String   @id @default(cuid())
  codigo                String   @unique
  nombre                String
  operacionesSoportadas String   @default("[]") // JSON: TipoOperacion[]
  capacidadHora         Float    @default(0)
  activa                Boolean  @default(true)
  creadoEn              DateTime @default(now())

  pasos                 PasoProduccion[]
  tiradas               Tirada[]
  controlesMP           ControlMP[]
  paros                 ParoProduccion[]
}

// =====================
// Pedidos del cliente
// =====================
enum EstadoPedido {
  BORRADOR
  CONFIRMADO
  EN_PRODUCCION
  TERMINADO
  ENTREGADO
  CANCELADO
}

model Pedido {
  id              String       @id @default(cuid())
  /// Folio visible: si el cliente tiene prefijo → "VFGC-861". Si no → "183674" (6 dígitos numéricos)
  folio           String       @unique
  /// Correlativo interno numérico siempre asignado.
  numeroInterno   Int          @unique
  clienteId       String
  cliente         Cliente      @relation(fields: [clienteId], references: [id])
  vendedorId      String?
  vendedor        Usuario?     @relation("PedidoVendedor", fields: [vendedorId], references: [id])
  comercialId     String?
  comercial       Usuario?     @relation("PedidoComercial", fields: [comercialId], references: [id])
  fechaPedido     DateTime     @default(now())
  fechaCompromiso DateTime
  estado          EstadoPedido @default(BORRADOR)
  notas           String?
  totalEstimado   Float        @default(0)
  creadoEn        DateTime     @default(now())
  actualizadoEn   DateTime     @updatedAt

  items           ItemPedido[]
  ordenes         OrdenProduccion[]
  pedidosAlmacen  PedidoAlmacen[]
  rollos          Rollo[]
}

model ItemPedido {
  id                   String   @id @default(cuid())
  pedidoId             String
  pedido               Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId           String
  producto             Producto @relation(fields: [productoId], references: [id])
  cantidad             Float
  unidad               UnidadMedida
  medidaSolicitada     String?  // formato "3.30×1391.72" o "7.70×100"
  especificacionesItem String   @default("{}")
  precioUnitario       Float    @default(0)
  cantidadProducida    Float    @default(0)
}

// =====================
// Pedido de Almacén (documento interno separado del pedido del cliente)
// =====================
enum EstadoPedidoAlmacen {
  PENDIENTE
  ENTREGADO_PARCIAL
  ENTREGADO
  CANCELADO
}

/// Documento "Pedido de Almacén" — solicitud interna de MP/producto a almacén para producción.
/// Sigue el formato corporativo Mallatex: SOLICITO → ENTREGO.
model PedidoAlmacen {
  id              String              @id @default(cuid())
  folio           String              @unique   // PA-2026-00001
  fecha           DateTime            @default(now())
  pedidoId        String?
  pedido          Pedido?             @relation(fields: [pedidoId], references: [id])
  solicitanteId   String
  solicitante     Usuario             @relation("PASolicito", fields: [solicitanteId], references: [id])
  entregadoPorId  String?
  entregadoPor    Usuario?            @relation("PAEntrego", fields: [entregadoPorId], references: [id])
  fechaEntrega    DateTime?
  estado          EstadoPedidoAlmacen @default(PENDIENTE)
  notas           String?

  partidas        PartidaPedidoAlmacen[]
}

model PartidaPedidoAlmacen {
  id                  String        @id @default(cuid())
  pedidoAlmacenId     String
  pedidoAlmacen       PedidoAlmacen @relation(fields: [pedidoAlmacenId], references: [id], onDelete: Cascade)
  codigo              String        // CUNEGRO105GR
  descripcion         String
  unidad              UnidadMedida  @default(METRO_CUADRADO)
  cantidad            Float
  medida              String?       // "7.70×100"
  numeroRollos        Int?
  notas               String?
}

// =====================
// Producción
// =====================
enum EstadoOrdenProduccion {
  PENDIENTE
  EN_PROCESO
  PAUSADA
  TERMINADA
  CANCELADA
}

enum EstadoPaso {
  PENDIENTE
  EN_PROCESO
  TERMINADO
  OMITIDO
}

enum Turno {
  MATUTINO    // 06:00 - 14:00
  VESPERTINO  // 14:00 - 22:00
  NOCTURNO    // 22:00 - 06:00
}

model OrdenProduccion {
  id            String                @id @default(cuid())
  folio         String                @unique
  pedidoId      String?
  pedido        Pedido?               @relation(fields: [pedidoId], references: [id])
  productoId    String
  producto      Producto              @relation(fields: [productoId], references: [id])
  creadorId     String
  creador       Usuario               @relation("OrdenCreador", fields: [creadorId], references: [id])
  cantidadPlan  Float
  unidad        UnidadMedida
  estado        EstadoOrdenProduccion @default(PENDIENTE)
  prioridad     Int                   @default(3)
  fechaPlan     DateTime
  fechaInicio   DateTime?
  fechaFin      DateTime?
  notas         String?
  creadoEn      DateTime              @default(now())

  pasos      PasoProduccion[]
  registros  RegistroProduccion[]
  tiradas    Tirada[]
  paros      ParoProduccion[]
  controlesMP ControlMP[]
  rollos     Rollo[]
}

/// Paso de la ruta productiva. Una orden de Cubrenegro puede pasar por:
/// extrusión → embobinar → planchar → corte → empaque.
model PasoProduccion {
  id            String          @id @default(cuid())
  ordenId       String
  orden         OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  secuencia     Int
  operacionId   String
  operacion     Operacion       @relation(fields: [operacionId], references: [id])
  lineaId       String?
  linea         LineaProduccion? @relation(fields: [lineaId], references: [id])
  operarioId    String?
  operario      Usuario?        @relation("PasoOperario", fields: [operarioId], references: [id])
  estado        EstadoPaso      @default(PENDIENTE)
  cantidadOk    Float           @default(0)
  cantidadMerma Float           @default(0)
  fechaInicio   DateTime?
  fechaFin      DateTime?
  notas         String?

  @@unique([ordenId, secuencia])
}

/// Tirada (corrida) = sesión de máquina-turno-responsable. Formato MT-DT-004.
model Tirada {
  id             String          @id @default(cuid())
  folio          String          @unique
  fecha          DateTime
  horaInicio    String                                          // "06:10"
  horaFin       String?                                         // "14:00"
  lineaId        String
  linea          LineaProduccion @relation(fields: [lineaId], references: [id])
  responsableId  String
  responsable    Usuario         @relation("TiradaResponsable", fields: [responsableId], references: [id])
  ordenId        String?
  orden          OrdenProduccion? @relation(fields: [ordenId], references: [id])
  pedidoFolio    String?                                         // referencia rápida (ej. "EZE 503")
  totalM2        Float           @default(0)
  totalMetrosLineales Float       @default(0)
  totalPiezas    Int             @default(0)
  imprevistos    String?
  notas          String?
  creadoEn       DateTime        @default(now())
}

model RegistroProduccion {
  id              String           @id @default(cuid())
  ordenId         String
  orden           OrdenProduccion  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  operarioId      String
  operario        Usuario          @relation(fields: [operarioId], references: [id])
  turno           Turno
  inicio          DateTime
  fin             DateTime?
  cantidadOk      Float            @default(0)
  cantidadMerma   Float            @default(0)
  notas           String?
  creadoEn        DateTime         @default(now())
}

enum MotivoParo {
  CAMBIO_MOLDE
  MANTENIMIENTO
  FALLA_LINEA
  FALTA_MATERIA_PRIMA
  CAMBIO_TURNO
  CALIDAD
  ENERGIA
  IMPREVISTO
  OTRO
}

model ParoProduccion {
  id          String          @id @default(cuid())
  ordenId     String?
  orden       OrdenProduccion? @relation(fields: [ordenId], references: [id])
  lineaId     String
  linea       LineaProduccion @relation(fields: [lineaId], references: [id])
  motivo      MotivoParo
  inicio      DateTime
  fin         DateTime?
  duracionMin Int?
  descripcion String?
  creadoEn    DateTime        @default(now())
}

// =====================
// Control MP en Producción (MT-DT-003)
// Categoriza cada incidencia de MP en producción, no solo "merma".
// =====================
enum CategoriaIncidenciaMP {
  EXCEDENTE        // sobró m de lo planeado (positivo)
  DEFECTO          // m con problema de calidad detectado
  FALTANTE         // m faltantes vs. lo planeado (negativo)
  SOBRANTE         // queda en planta sin usar
  DESPERDICIO      // no aprovechable
}

model ControlMP {
  id              String                @id @default(cuid())
  ordenId         String
  orden           OrdenProduccion       @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  fechaElaboracion DateTime
  productoId      String?
  producto        Producto?             @relation(fields: [productoId], references: [id])
  material        String                                  // "Cubresuelo Negro", "Antigranizo"
  medida          String?                                 // "3.30×1391.72"
  lineaId         String?
  linea           LineaProduccion?      @relation(fields: [lineaId], references: [id])
  loteId          String?
  lote            LoteMP?               @relation(fields: [loteId], references: [id])
  categoria       CategoriaIncidenciaMP
  cantidad        Float                                   // m, m², kg según unidad
  unidad          UnidadMedida          @default(METRO_LINEAL)
  observaciones   String?
  registradoPorId String
  registradoPor   Usuario               @relation(fields: [registradoPorId], references: [id])
  creadoEn        DateTime              @default(now())
}

// =====================
// Trazabilidad de rollos
// =====================
enum EstadoRollo {
  EN_PROCESO
  TERMINADO
  EN_INSPECCION
  LIBERADO
  RECHAZADO
  ENTREGADO
}

model Rollo {
  id              String      @id @default(cuid())
  codigo          String      @unique
  ordenId         String
  orden           OrdenProduccion @relation(fields: [ordenId], references: [id])
  pedidoId        String?
  pedido          Pedido?     @relation(fields: [pedidoId], references: [id])
  productoId      String
  producto        Producto    @relation(fields: [productoId], references: [id])
  anchoMetros     Float                                       // 1.80, 4.10
  largoMetros     Float                                       // 500, 74, 587
  peso            Float?                                      // kg
  elaboradoPorId  String?
  elaboradoPor    Usuario?    @relation("RolloElaborador", fields: [elaboradoPorId], references: [id])
  notasEtiqueta   String?                                     // "Perforados cada 70cm"
  qrPayload       String                                      // contenido del QR/etiqueta
  estado          EstadoRollo @default(EN_PROCESO)
  ubicacion       String?
  creadoEn        DateTime    @default(now())

  inspecciones    InspeccionCalidad[]
}

// =====================
// Calidad
// =====================
enum ResultadoInspeccion {
  APROBADO
  RECHAZADO
  RETRABAJO
}

model InspeccionCalidad {
  id            String              @id @default(cuid())
  rolloId       String?
  rollo         Rollo?              @relation(fields: [rolloId], references: [id])
  inspectorId   String
  inspector     Usuario             @relation(fields: [inspectorId], references: [id])
  fecha         DateTime            @default(now())
  resultado     ResultadoInspeccion
  defectos      String              @default("[]")
  observaciones String?
}

// =====================
// Inventario y almacenes
// =====================
enum TipoMovimiento {
  ENTRADA
  SALIDA
  TRASPASO
  MERMA
  AJUSTE
  DEVOLUCION
}

model Almacen {
  id          String   @id @default(cuid())
  codigo      String   @unique
  nombre      String
  tipo        String     // MATERIA_PRIMA / PRODUCTO_PROCESO / PRODUCTO_TERMINADO
  ubicacion   String?
  activo      Boolean  @default(true)

  movimientos MovimientoStock[]
}

model MovimientoStock {
  id              String         @id @default(cuid())
  almacenId       String
  almacen         Almacen        @relation(fields: [almacenId], references: [id])
  productoId      String?
  producto        Producto?      @relation(fields: [productoId], references: [id])
  materiaPrimaId  String?
  materiaPrima    MateriaPrima?  @relation(fields: [materiaPrimaId], references: [id])
  tipo            TipoMovimiento
  cantidad        Float
  unidad          UnidadMedida
  referencia      String?
  fecha           DateTime       @default(now())
  notas           String?
}

// =====================
// Activos y mantenimiento (Check List diario montacargas)
// =====================
model Activo {
  id        String   @id @default(cuid())
  numeroEco String   @unique           // No. económico
  modelo    String?
  serie     String?
  tipo      String                     // "montacargas", "extrusora", etc.
  activo    Boolean  @default(true)

  inspecciones InspeccionMontacargas[]
}

/// Check List diario de Montacargas (formato corporativo Mallatex)
model InspeccionMontacargas {
  id              String   @id @default(cuid())
  activoId        String
  activo          Activo   @relation(fields: [activoId], references: [id])
  operadorId      String
  operador        Usuario  @relation("ChecklistOperador", fields: [operadorId], references: [id])
  supervisorId    String?
  supervisor      Usuario? @relation("ChecklistSupervisor", fields: [supervisorId], references: [id])
  fecha           DateTime
  turno           Turno
  horas           Int?      // horómetro
  // JSON con resultado por sección/punto (visual y operacional)
  // [{ "seccion": "Ruedas", "punto": "Sin daños", "estado": "OK"|"R"|"N/A" }, ...]
  resultados      String    @default("[]")
  observaciones   String?
  conRevision     Boolean   @default(false)     // true si algún punto está R
  creadoEn        DateTime  @default(now())
}

// =====================
// Insumos auxiliares (cintas, hilo, agujas)
// =====================
enum TipoInsumoAux {
  CINTA_TRANSPARENTE
  CINTA_MALLATEX
  HILO
  AGUJAS_OVER
  AGUJAS_RECTA
  OTRO
}

model InsumoAuxiliar {
  id          String        @id @default(cuid())
  codigo      String        @unique
  nombre      String
  tipo        TipoInsumoAux
  unidad      UnidadMedida  @default(PIEZA)
  stockMinimo Float         @default(0)

  consumos    ConsumoInsumoAux[]
}

/// Consumo diario de insumo auxiliar por empleado (formato calendario mensual)
model ConsumoInsumoAux {
  id          String         @id @default(cuid())
  insumoId    String
  insumo      InsumoAuxiliar @relation(fields: [insumoId], references: [id])
  empleadoId  String
  empleado    Usuario        @relation(fields: [empleadoId], references: [id])
  fecha       DateTime
  cantidad    Float
  notas       String?

  @@index([fecha])
  @@index([empleadoId, fecha])
}
