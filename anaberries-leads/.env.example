# Puerto del servidor
PORT=4000

# PIN del personal para Sorteo y Dashboard (déjalo vacío para acceso abierto en pruebas)
STAFF_PIN=1234

# Directorio de datos (por defecto ./data). En producción usa un volumen persistente.
# DATA_DIR=/data

# Entorno (production activa cacheo de estáticos y trust proxy por defecto)
# NODE_ENV=production

# Nº de proxies de confianza para obtener la IP real (nginx/Render). En prod por defecto = 1.
# TRUST_PROXY=1

# Límite anti-spam del autoregistro público (por IP). Generoso por el NAT del venue.
# REGISTRO_RATE_MAX=60
# REGISTRO_RATE_WINDOW_MS=60000

# PostgreSQL (recomendado en producción). Si se define, la app usa Postgres.
# DATABASE_URL=postgresql://usuario:password@host:5432/basededatos

# Correo del ganador (SMTP). Si SMTP_HOST está vacío, el envío se omite y el
# folio se entrega manualmente. Ejemplo con un proveedor SMTP:
# SMTP_HOST=smtp.tuservidor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=password
# MAIL_FROM=Mallatex <no-reply@mallatex.com.mx>
