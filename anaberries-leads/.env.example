# Puerto del servidor
PORT=4000

# Administrador. Si defines ADMIN_EMAIL, ese administrador queda garantizado en
# cada arranque: se crea automáticamente si aún no existe (sin tocar a los demás
# usuarios). Basta con configurar ADMIN_EMAIL + ADMIN_PASSWORD para asegurar el acceso.
ADMIN_EMAIL=admin@mallatex.com
ADMIN_PASSWORD=cambia-esta-clave
# ADMIN_NAME=Administrador

# Secreto para firmar los tokens de sesión (si se omite, se genera y guarda en la base)
# AUTH_SECRET=una-cadena-larga-y-secreta
# AUTH_TTL_HOURS=12

# Poner en "true" (una vez) para (re)establecer el admin ADMIN_EMAIL con ADMIN_PASSWORD
# aunque ya existan usuarios; luego quítalo. Útil si olvidaste la contraseña.
# ADMIN_RESET=true

# NIP estático de configuración inicial. Permite ENTRAR SIN CONTRASEÑA (solo mientras
# la configuración esté abierta) para crear tus usuarios reales. Al finalizar la
# configuración desde la app, el NIP queda inservible. Vacío = deshabilitado.
# SETUP_PIN=246810
# En una base que YA tiene usuarios el NIP está cerrado. Para reabrirlo y recuperar
# el acceso, pon SETUP_REOPEN=true (una vez), entra con el NIP, crea usuarios,
# finaliza la configuración y quita ambas variables.
# SETUP_REOPEN=true

# Directorio de datos (por defecto ./data). En producción usa un volumen persistente.
# DATA_DIR=/data

# Entorno (production activa cacheo de estáticos y trust proxy por defecto)
# NODE_ENV=production

# Nº de proxies de confianza para obtener la IP real (nginx/Render). En prod por defecto = 1.
# TRUST_PROXY=1

# Límite anti-spam del autoregistro público (por IP). Generoso por el NAT del venue.
# REGISTRO_RATE_MAX=60
# REGISTRO_RATE_WINDOW_MS=60000

# PostgreSQL (recomendado en producción). Si se define, la app usa Postgres.
# DATABASE_URL=postgresql://usuario:password@host:5432/basededatos

# Correo del ganador (SMTP). Si SMTP_HOST está vacío, el envío se omite y el
# folio se entrega manualmente. Ejemplo con un proveedor SMTP:
# SMTP_HOST=smtp.tuservidor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=password
# MAIL_FROM=Mallatex <no-reply@mallatex.com.mx>
